# -------------------------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Duplicate 'sample.env.production' as '.env.production' in the current directory env/.
# 2. Update the credentials below with your actual values in .env.production file.
# 3. DO NOT commit the '.env.production' file to your git repository (it is hidden via .gitignore).
# -------------------------------------------------------------------------------------------------

# Production logging configuration

LOG_CONSOLE_ENABLED=false
LOG_CONSOLE_LEVEL=INFO

LOG_FILE_ENABLED=true
LOG_FILE_LEVEL=INFO
LOG_FILE_PATH=log/ahaapi.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=180
LOG_FILE_ROTATION_HOUR=2

LOG_EMAIL_ENABLED=true
LOG_EMAIL_LEVEL=CRITICAL
LOG_EMAIL_HOST=smtp.example.com
LOG_EMAIL_PORT=587
LOG_EMAIL_USE_TLS=true
LOG_EMAIL_USERNAME=your-smtp-account
LOG_EMAIL_PASSWORD=your-smtp-password
LOG_EMAIL_FROM=alerts@example.com
LOG_EMAIL_TO=admin@example.com,ops@example.com
